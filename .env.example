# Client (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / API (alternative names for same values)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# App
CLIENT_URL=http://localhost:5173
SERVER_PORT=3001

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob (Accept)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Charge currency accepted by your Paymob MID (SAR aligns with USD_TO_SAR conversion)
PAYMOB_CURRENCY=SAR

# Exchange: how many SAR per 1 USD (adjust to market). Default in code: 3.75
USD_TO_SAR_RATE=3.75
# Alias supported in code:
# EXCHANGE_RATE_USD_TO_SAR=3.75

# Production
# VERCEL_URL=